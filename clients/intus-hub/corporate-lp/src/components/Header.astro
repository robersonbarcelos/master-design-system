---
import ApplyButton from "./ApplyButton.astro";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href="#top" class="font-display text-lg font-bold tracking-tight text-white-ice">
      Intus<span class="text-bright-gold">·</span>Hub
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      <a href="#como-funciona" class="label-text relative text-white-ice/70 transition-colors hover:text-white-ice active:text-light-blue after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-electric-blue after:transition-all after:duration-200 hover:after:w-full">
        Como Funciona
      </a>
      <a href="#seguranca" class="label-text relative text-white-ice/70 transition-colors hover:text-white-ice active:text-light-blue after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-electric-blue after:transition-all after:duration-200 hover:after:w-full">
        Segurança
      </a>
      <a href="#prova" class="label-text relative text-white-ice/70 transition-colors hover:text-white-ice active:text-light-blue after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-electric-blue after:transition-all after:duration-200 hover:after:w-full">
        Prova
      </a>
      <a href="#faq" class="label-text relative text-white-ice/70 transition-colors hover:text-white-ice active:text-light-blue after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-electric-blue after:transition-all after:duration-200 hover:after:w-full">
        FAQ
      </a>
    </nav>

    <ApplyButton variant="primary" label="Aplicar" class="!px-6 !py-3 text-xs" />
  </div>
</header>

<script>
  const header = document.getElementById("site-header");

  if (header) {
    const onScroll = () => {
      if (window.scrollY > 24) {
        header.classList.add("bg-hub-night/90", "backdrop-blur-md", "border-electric-blue/10");
      } else {
        header.classList.remove("bg-hub-night/90", "backdrop-blur-md", "border-electric-blue/10");
      }
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
