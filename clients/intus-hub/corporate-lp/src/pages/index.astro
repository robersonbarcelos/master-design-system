---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Proof from "../components/Proof.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Security from "../components/Security.astro";
import DedicatedInterface from "../components/DedicatedInterface.astro";
import Scarcity from "../components/Scarcity.astro";
import Guarantee from "../components/Guarantee.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import ApplyModal from "../components/ApplyModal.astro";
---

<Layout>
  <Header />
  <main id="main-content">
    <Hero />
    <Problem />
    <Proof />
    <HowItWorks />
    <Security />
    <DedicatedInterface />
    <Scarcity />
    <Guarantee />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
  <ApplyModal />
</Layout>
