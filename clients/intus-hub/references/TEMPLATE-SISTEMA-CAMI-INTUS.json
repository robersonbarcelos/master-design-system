  "alternancia_sugerida": [
    "CAPA              → capa-full-bleed",
    "SLIDE 1           → texto-puro",
    "SLIDE 2           → ui-corpo-split variante A ou C",
    "SLIDE 3           → texto-numerado",
    "SLIDE 4           → ui-corpo-split variante B",
    "SLIDE 5           → texto-puro",
    "CTA               → cta-palavra-gatilho"
  ],

  "negative_rules_globais": [
    "background claro sempre #F8F6F0 — nunca #FFFFFF branco puro",
    "UI screenshots sempre border-radius 14-16px — nunca square",
    "botão nav sempre verde #00FF88 com seta → preta",
    "botão nav presente em TODOS os slides exceto CTA final",
    "acento laranja #E8722A não existe neste sistema",
    "sem travessão em nenhum template",
    "margens left e right sempre 44px — trava absoluta nos dois lados"
  ]
}
