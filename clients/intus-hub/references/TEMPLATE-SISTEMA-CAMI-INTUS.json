        "body_block": {
          "position": "below headline",
          "margin_left": "44px",
          "margin_right": "44px",
          "max_width": "992px",
          "margin_top": "40px",
          "font_size": "30px",
          "font_style": "regular sans-serif",
          "font_color": "#555555",
          "line_height": "1.6",
          "bold_support": true,
          "text_align": "left",
          "text_wrap": "wrap — quebrar linha somente ao atingir margin_right 44px",
          "max_linhas": 6
