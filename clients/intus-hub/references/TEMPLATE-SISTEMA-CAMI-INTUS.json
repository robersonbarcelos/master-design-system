{
  "sistema": "intus-hub-cami-style",
  "versao": "1.1",
  "descricao": "Sistema de templates inspirado na referência Cami Lab, adaptado para Intus Hub / Diego Spanevello. 5 templates num arquivo único.",
  "data": "2026-07-03",

  "design_tokens": {
    "background_claro": "#F8F6F0",
    "background_escuro": "image-full-bleed com overlay",
    "texto_principal": "#0A0A0A",
    "texto_secundario": "#555555",
    "texto_sobre_escuro": "#FFFFFF",
    "acento": "#00FF88",
    "acento_note": "Verde neon — usado em: highlight box, botão nav, separador header, ícones de checklist.",
    "ui_screenshot_bg": "#1A1A1A"
  },

  "typography_locks": {
    "headline_all_caps": "96px mínimo — nunca abaixo. Quebrar em mais linhas se necessário, nunca reduzir fonte.",
    "headline_mixed_case": "88px mínimo — nunca abaixo. Ajustar copy, nunca fonte.",
    "corpo_principal": "30px mínimo — parágrafos e blocos de conteúdo.",
    "corpo_lateral": "26px mínimo — texto ao lado de imagem (painel direito split).",
    "checklist_label": "14px — fixo.",
    "callout_card_texto": "18px mínimo — fixo.",
    "footer_handle": "20px — fixo.",
    "header_tag": "18px — fixo.",
    "regra_geral": "Se o copy não cabe com o tamanho mínimo, reduzir o copy — nunca a fonte."
  },

  "safe_zone": {
    "left": "44px",
    "right": "44px",
    "content_width": "992px",
    "note": "⚠️ TRAVA ABSOLUTA — nenhum elemento ultrapassa 44px de cada lado. Texto flui até 992px e quebra linha SOMENTE ao atingir margin_right. Nunca quebrar antes."
  },

  "nav_button": {
    "shape": "pill oval",
    "width": "96px",
    "height": "58px",
    "background": "#00FF88",
    "content": "→",
    "font_color": "#0A0A0A",
    "border_radius": "999px",
    "position": "footer direita",
    "regra": "PRESENTE em todos os slides EXCETO o CTA final"
  },

  "templates": {

    "CAPA": {
      "nome": "capa-full-bleed",
      "descricao": "Capa com foto full-bleed escura. Tag no topo. Headline ALL CAPS branca com palavra em highlight box verde. Botão nav no footer.",
      "format": {
        "aspect_ratio": "4:5",
        "resolution": "1080x1350px",
        "background": "image-full-bleed — foto escura obrigatória"
      },
      "overlay": {
        "type": "gradient bottom-to-top",
        "stops": [
          { "position": "0%", "color": "rgba(0,0,0,0.90)" },
          { "position": "45%", "color": "rgba(0,0,0,0.50)" },
          { "position": "100%", "color": "rgba(0,0,0,0.10)" }
        ]
      },
      "zones": {
        "header_tag": {
          "position": "top",
          "margin_left": "44px",
          "margin_right": "44px",
          "margin_top": "40px",
          "content": "DIEGO SPANEVELLO · Inteligência Artificial",
          "font_size": "18px",
          "font_style": "regular sans-serif, letter-spacing 2px",
          "font_color": "rgba(255,255,255,0.75)",
          "separador": { "character": "·", "color": "#00FF88" }
        },
        "headline_block": {
          "position": "bottom",
          "margin_left": "44px",
          "margin_right": "44px",
          "max_width": "992px",
          "margin_bottom": "88px",
          "line_height": "1.0",
          "font_size": "100px",
          "font_style": "ultra bold condensed, all caps",
          "text_wrap": "wrap — quebrar linha somente ao atingir margin_right 44px",
          "lines": [
            { "content": "LINHA NORMAL", "font_color": "#FFFFFF" },
            { "content": "LINHA NORMAL", "font_color": "#FFFFFF" },
            {
              "content": "PALAVRA-CHAVE",
              "font_color": "#0A0A0A",
              "highlight": {
                "background": "#00FF88",
                "padding": "2px 18px",
                "border_radius": "6px",
                "display": "inline-block",
                "width": "fit-content"
              }
            },
            { "content": "LINHA NORMAL.", "font_color": "#FFFFFF" }
          ]
        },
        "footer": {
          "height": "72px",
          "position": "bottom",
          "margin_left": "44px",
          "margin_right": "44px",
          "margin_bottom": "32px",
          "left": { "content": "@diego.spanevello", "font_size": "22px", "font_color": "rgba(255,255,255,0.70)" },
          "right": { "nav_button": "ver design_tokens.nav_button" }
        }
      },
      "negative_rules": [
        "foto nunca clara — overlay obrigatório",
        "máximo 1 palavra com highlight box",
        "headline sempre ALL CAPS condensado",
        "header tag: DIEGO SPANEVELLO · Inteligência Artificial — não alterar"
      ]
    },

