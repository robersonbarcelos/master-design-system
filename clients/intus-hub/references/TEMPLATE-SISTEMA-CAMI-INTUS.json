        "footer": {
          "height": "60px",
          "position": "bottom",
          "margin_left": "44px",
          "margin_right": "44px",
          "margin_bottom": "40px",
          "left": { "content": "@diego.spanevello", "font_size": "20px", "font_color": "#AAAAAA" },
