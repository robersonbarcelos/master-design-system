          "font_color": "#0A0A0A",
          "line_height": "1.0",
          "margin_bottom": "16px",
          "note": "PLACEHOLDER — preencher a cada notícia"
        },
        {
          "id": "subcopy",
          "font_size": "28px",
          "font_style": "regular sans-serif",
          "font_color": "#555555",
