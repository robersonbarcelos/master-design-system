{
  "template_family": "TEMPLATE-INTUS-AI-NEWS",
  "description": "Template para posts estáticos de notícias de IA no perfil Intus HUB. Formato híbrido: imagem/sticker na metade superior + badge + headline bold na metade inferior.",
  "format": {
    "aspect_ratio": "4:5",
    "resolution": "1080x1350px",
    "background_color": "#F8F6F0"
  },
  "global_rules": [
    "badge SEMPRE acima da headline, nunca no topo do frame",
    "badge content: variação conforme template escolhido — nunca 'Inteligência Artificial'",
    "fonte: OPCIONAL — incluir apenas quando houver fonte de referência na notícia",
    "image color_treatment: LIVRE por notícia — pode ser P&B total, colorido total, ou seletivo (ex: personagem P&B + elementos coloridos). Nunca travar em um único estilo",
    "footer: SEM @handle — removido do template",
    "nunca alterar copy fornecida pelo usuário"
  ],
  "image_zone": {
    "position": "centro superior do frame",
    "height": "55% do frame",
    "generate": false,
    "color_treatment": "LIVRE — P&B total / colorido total / seletivo conforme a notícia",
    "note": "⚠️ USUÁRIO CARREGA imagem ou sticker do personagem da notícia"
  },
  "content_zone": {
    "position": "metade inferior do frame",
    "margin_left": "44px",
    "margin_right": "44px",
    "margin_top": "24px"
  },
  "footer": {
    "exists": false,
    "note": "SEM @handle no footer — removido do template"
  },
  "variations": [
    {
      "id": "01-breaking-badge-vermelha",
      "name": "Breaking News — Badge Vermelha Sólida",
      "description": "Badge vermelha urgência estilo breaking news. Tom jornalístico de impacto.",
      "blocks": [
        {
          "id": "badge",
          "content": "INTUS HUB · AI NEWS",
          "font_size": "18px",
          "font_style": "ultra bold uppercase letter-spacing 2px",
          "font_color": "#FFFFFF",
          "background": "#CC0000",
          "padding": "8px 20px",
          "border_radius": "4px",
          "display": "inline-block",
          "margin_bottom": "16px",
          "separador": {
            "character": "·",
            "color": "rgba(255,255,255,0.55)",
            "margin": "0 8px"
          }
        },
        {
          "id": "headline",
          "font_size": "88px",
          "font_style": "ultra bold condensed, all caps",
          "font_color": "#0A0A0A",
          "line_height": "1.0",
          "margin_bottom": "16px",
          "note": "PLACEHOLDER — preencher a cada notícia"
        },
        {
          "id": "subcopy",
          "font_size": "28px",
          "font_style": "regular sans-serif",
          "font_color": "#555555",
          "line_height": "1.5",
          "margin_bottom": "20px",
          "note": "PLACEHOLDER — preencher a cada notícia"
        },
        {
          "id": "fonte",
          "font_size": "16px",
          "font_color": "#AAAAAA",
          "note": "OPCIONAL — incluir apenas quando houver fonte de referência na notícia"
        }
      ]
    },
    {
      "id": "02-badge-dois-blocos-verde",
      "name": "Dois Blocos — INTUS HUB preto + AI NEWS verde",
